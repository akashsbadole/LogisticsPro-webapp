// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Management with Role-Based Access
enum UserRole {
  ADMIN
  WAREHOUSE_MANAGER
  DRIVER
  CUSTOMER
  PARTNER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  password    String
  name        String
  role        UserRole    @default(CUSTOMER)
  status      UserStatus  @default(ACTIVE)
  phone       String?
  avatar      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  managedWarehouses Warehouse[] @relation("WarehouseManager")
  shipments        Shipment[]   @relation("ShipmentDriver")
  drivenVehicles   Vehicle[]    @relation("VehicleDriver")
  orders           Order[]      @relation("OrderCustomer")
  invoices         Invoice[]    @relation("InvoiceCustomer")
  reviews          Review[]

  @@map("users")
}

// Warehouse Management
enum WarehouseStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model Warehouse {
  id          String            @id @default(cuid())
  name        String
  code        String            @unique
  address     String
  city        String
  state       String
  country     String
  postalCode  String
  phone       String?
  email       String?
  capacity    Int               // Maximum storage capacity
  status      WarehouseStatus   @default(ACTIVE)
  managerId   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  manager     User?             @relation("WarehouseManager", fields: [managerId], references: [id])
  inventory   Inventory[]
  zones       WarehouseZone[]
  orders      Order[]

  @@map("warehouses")
}

model WarehouseZone {
  id          String   @id @default(cuid())
  name        String
  code        String
  warehouseId String
  capacity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  inventory   Inventory[]

  @@map("warehouse_zones")
}

// Inventory Management
enum InventoryStatus {
  AVAILABLE
  RESERVED
  IN_TRANSIT
  DAMAGED
  EXPIRED
}

model Inventory {
  id          String          @id @default(cuid())
  sku         String          @unique
  name        String
  description String?
  category    String
  quantity    Int             @default(0)
  unit        String          @default("pcs")
  price       Float           @default(0)
  weight      Float?          // in kg
  dimensions  String?         // JSON string for LxWxH
  barcode     String?
  qrCode      String?
  batchNumber String?
  expiryDate  DateTime?
  status      InventoryStatus @default(AVAILABLE)
  warehouseId String
  zoneId      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zone        WarehouseZone?  @relation(fields: [zoneId], references: [id])
  orderItems  OrderItem[]
  shipmentItems ShipmentItem[]

  @@map("inventory")
}

// Vehicle and Fleet Management
enum VehicleStatus {
  AVAILABLE
  IN_TRANSIT
  MAINTENANCE
  OUT_OF_SERVICE
}

enum VehicleType {
  TRUCK
  VAN
  MOTORCYCLE
  SHIP
  PLANE
}

model Vehicle {
  id          String        @id @default(cuid())
  licensePlate String       @unique
  make        String
  model       String
  year        Int?
  type        VehicleType
  capacity    Float         // in kg
  status      VehicleStatus @default(AVAILABLE)
  driverId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  driver      User?         @relation("VehicleDriver", fields: [driverId], references: [id])
  shipments   Shipment[]
  maintenance Maintenance[]

  @@map("vehicles")
}

model Maintenance {
  id          String   @id @default(cuid())
  vehicleId   String
  type        String
  description String
  cost        Float?
  date        DateTime
  status      String   @default("SCHEDULED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("maintenance")
}

// Order Management
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  customerId  String
  warehouseId String
  status      OrderStatus @default(PENDING)
  totalAmount Float
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  customer    User        @relation("OrderCustomer", fields: [customerId], references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
  items       OrderItem[]
  shipments   Shipment[]
  invoices    Invoice[]

  @@map("orders")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  inventoryId String
  quantity   Int
  price      Float
  createdAt  DateTime @default(now())

  // Relations
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventory  Inventory @relation(fields: [inventoryId], references: [id])

  @@map("order_items")
}

// Shipment Management
enum ShipmentStatus {
  PENDING
  PICKUP_SCHEDULED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  DELAYED
}

enum ShipmentType {
  STANDARD
  EXPRESS
  OVERNIGHT
  INTERNATIONAL
}

model Shipment {
  id            String          @id @default(cuid())
  trackingNumber String         @unique
  orderId       String?
  vehicleId     String?
  driverId      String?
  origin        String
  destination   String
  status        ShipmentStatus  @default(PENDING)
  type          ShipmentType    @default(STANDARD)
  weight        Float?
  dimensions    String?         // JSON string
  distance      Float?          // in km
  estimatedDelivery DateTime?
  actualDelivery DateTime?
  cost          Float
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  order         Order?          @relation(fields: [orderId], references: [id])
  vehicle       Vehicle?        @relation(fields: [vehicleId], references: [id])
  driver        User?           @relation("ShipmentDriver", fields: [driverId], references: [id])
  items         ShipmentItem[]
  tracking      ShipmentTracking[]
  proofOfDelivery ProofOfDelivery?
  reviews       Review[]

  @@map("shipments")
}

model ShipmentItem {
  id          String   @id @default(cuid())
  shipmentId  String
  inventoryId String
  quantity    Int
  createdAt   DateTime @default(now())

  // Relations
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  inventory   Inventory @relation(fields: [inventoryId], references: [id])

  @@map("shipment_items")
}

model ShipmentTracking {
  id          String   @id @default(cuid())
  shipmentId  String
  location    String
  latitude    Float?
  longitude   Float?
  status      String
  timestamp   DateTime @default(now())
  notes       String?

  // Relations
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("shipment_tracking")
}

model ProofOfDelivery {
  id            String   @id @default(cuid())
  shipmentId    String   @unique
  signature     String?  // Base64 encoded
  photo         String?  // Base64 encoded
  recipientName String
  notes         String?
  deliveredAt   DateTime @default(now())

  // Relations
  shipment     Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("proof_of_delivery")
}

// Billing and Invoicing
enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Invoice {
  id            String         @id @default(cuid())
  invoiceNumber String         @unique
  orderId       String?
  customerId    String
  amount        Float
  tax           Float          @default(0)
  totalAmount   Float
  status        InvoiceStatus  @default(DRAFT)
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  order         Order?         @relation(fields: [orderId], references: [id])
  customer      User           @relation("InvoiceCustomer", fields: [customerId], references: [id])
  payments      Payment[]

  @@map("invoices")
}

model Payment {
  id            String         @id @default(cuid())
  invoiceId     String
  amount        Float
  method        String         // CREDIT_CARD, BANK_TRANSFER, CASH, etc.
  transactionId String?
  status        PaymentStatus  @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime       @default(now())

  // Relations
  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// Reviews and Feedback
model Review {
  id          String   @id @default(cuid())
  userId      String
  shipmentId  String?
  rating      Int      // 1-5 stars
  comment     String?
  createdAt   DateTime @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipment    Shipment? @relation(fields: [shipmentId], references: [id])

  @@map("reviews")
}